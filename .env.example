# Server Environment
PORT=5000
SECRET_KEY=your_secret_key_here

# Relational Database Configuration
# Local SQLite: sqlite:///backend/aurelis.db
# Production PostgreSQL: postgresql://username:password@hostname:5432/aurelis_db
DATABASE_URL=sqlite:///backend/aurelis.db

# Administrator Information
ADMIN_NAME=Vikneshvaren
ADMIN_PHONE=9445437069
ADMIN_LOCATION=Tenkasi, Main Road, opposite the bus stand
ADMIN_EMAIL=vikneshvaren@gmail.com
ADMIN_PASSWORD=your_admin_password_here

# Payment Gateway (Razorpay UPI / Google Pay / NetBanking)
PAYMENT_KEY_ID=your_razorpay_key_id_here
PAYMENT_KEY_SECRET=your_razorpay_key_secret_here
PAYMENT_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Transactional Email Notification System (SMTP)
